package compress;

import java.awt.BorderLayout;
import java.awt.Dimension;
import javax.swing.ButtonGroup;
import javax.swing.JPanel;
import javax.swing.JRadioButton;
import javax.swing.JTextField;
import javax.swing.border.TitledBorder;
import com.module.Data;
import com.module.core.Module;
import com.module.core.ModuleDesc;
import com.module.ModuleInChain;
import com.module.core.Trace;
import com.module.operations.DataOperationException;

@SuppressWarnings("serial")
@ModuleDesc(pkgName="Resample", name="Resample", desc="",isVisible=false)
public class Resample extends Module implements ModuleInChain {
    public static final int COMPUTE_ONCE = 0;
    public static final int COMPUTE_ALWAYS = 1;
    public static final int NO_ALIGN = 0;
    public static final int PEAK_ALIGN = 1;
    public static final int CORRELATION_ALIGN = 2;
    public static final String RECOMPUTE = "recompute";
    public static final String RESAMPLE = "resample";
    public static final String MARGIN = "margin";
    public static final String ALIGN = "align";
    public static final String SAMPLES_PER_PERIOD = "samples.per.period";

    protected JTextField sampleFrequencyTextField;
    protected JTextField resampleFrequencyTextField;
    protected JTextField marginTextField;
    protected JTextField samplesPerPeriodTextField;
    protected JPanel sampleFrequencyPanel, alignPanel, typePanel;
    protected JRadioButton computeOnceButton, recomputeButton, noAlignButton, phaseAlignButton, peakAlignButton;
    public float initialResampleFrequency, resampleFrequency, factor, margin, period;
    public int fftSize, resampleLength, resampleFrequencyIndex, shift, firstShift, shiftLow, shiftHigh, align,
            samplesPerPeriod, intPeriod, halfPeriod, halfComparePeriod, comparePeriod;
    public boolean recompute, first;
    protected float[] refFreq, testSample, sr, s2r;

    /** method to initialize the module */
    public void initModule() {
        moduleTitle = "Resample";
        prefix = "Resampled";
        moduleDescription = "Resample traces with another frequency";
        moduleVersion = "1.4";
        helpFile = "doc/manual/modulesResample.html";
        resampleFrequency = 1;
        margin = 0.1f;
        recompute = false;
        align = PEAK_ALIGN;
        samplesPerPeriod = 1;
        set(RECOMPUTE, 0);
        set(RESAMPLE, resampleFrequency);
        set(MARGIN, margin);
        set(ALIGN, align);
        set(SAMPLES_PER_PERIOD, samplesPerPeriod);
    }

    public JPanel initDialog() {
        JPanel parameterPanel = new JPanel(new BorderLayout());
        JPanel northPanel = new JPanel();
        JPanel southPanel = new JPanel();
        northPanel.setBorder(new TitledBorder("Frequency"));
        sampleFrequencyPanel = new JPanel();
        sampleFrequencyPanel.setLayout(new BorderLayout());
        sampleFrequencyPanel.setBorder(new TitledBorder("Sample"));
        sampleFrequencyTextField = new JTextField(String.valueOf(sampleFrequency));
        sampleFrequencyTextField.setPreferredSize(new Dimension(90, 20));
        sampleFrequencyTextField.setToolTipText("Sample frequency of input traces");
        sampleFrequencyPanel.add(sampleFrequencyTextField, BorderLayout.CENTER);
        northPanel.add(sampleFrequencyPanel);
        JPanel resampleFrequencyPanel = new JPanel();
        resampleFrequencyPanel.setLayout(new BorderLayout());
        resampleFrequencyPanel.setBorder(new TitledBorder("Resample"));
        resampleFrequencyTextField = new JTextField(String.valueOf(resampleFrequency));
        resampleFrequencyTextField.setPreferredSize(new Dimension(90, 20));
        resampleFrequencyTextField.setToolTipText("Frequency used for resampling traces");
        resampleFrequencyPanel.add(resampleFrequencyTextField, BorderLayout.CENTER);
        northPanel.add(resampleFrequencyPanel);
        JPanel marginPanel = new JPanel();
        marginPanel.setLayout(new BorderLayout());
        marginPanel.setBorder(new TitledBorder("Margin"));
        marginTextField = new JTextField(String.valueOf(margin));
        marginTextField.setPreferredSize(new Dimension(50, 20));
        marginTextField.setToolTipText("Allowed deviation of estimated resample frequency");
        marginPanel.add(marginTextField, BorderLayout.CENTER);
        northPanel.add(marginPanel);
        ButtonGroup typeGroup = new ButtonGroup();
        typePanel = new JPanel();
        typePanel.setBorder(new TitledBorder("Resample frequency"));
        computeOnceButton = new JRadioButton("Once");
        computeOnceButton.setToolTipText("Compute resample frequency from estimate once");
        computeOnceButton.setSelected(true);
        typeGroup.add(computeOnceButton);
        typePanel.add(computeOnceButton);
        recomputeButton = new JRadioButton("Always");
        recomputeButton.setToolTipText("Compute resample frequency from estimate again for each trace");
        typeGroup.add(recomputeButton);
        typePanel.add(recomputeButton);
        northPanel.add(typePanel);
        alignPanel = new JPanel();
        alignPanel.setBorder(new TitledBorder("Alignment"));
        ButtonGroup alignGroup = new ButtonGroup();
        noAlignButton = new JRadioButton("None");
        noAlignButton.setToolTipText("No alignment before resampling");
        noAlignButton.setSelected(true);
        alignPanel.add(noAlignButton);
        alignGroup.add(noAlignButton);
        peakAlignButton = new JRadioButton("Peak");
        peakAlignButton.setToolTipText("Align on peak value");
        alignPanel.add(peakAlignButton);
        alignGroup.add(peakAlignButton);
        phaseAlignButton = new JRadioButton("Correlation");
        phaseAlignButton.setToolTipText("Align by correlation");
        alignPanel.add(phaseAlignButton);
        alignGroup.add(phaseAlignButton);
        southPanel.add(alignPanel);
        JPanel samplesPerPeriodPanel = new JPanel(new BorderLayout());
        samplesPerPeriodPanel.setBorder(new TitledBorder("Samples"));
        samplesPerPeriodTextField = new JTextField();
        samplesPerPeriodTextField.setToolTipText("Samples to compute per resampling period");
        samplesPerPeriodTextField.setPreferredSize(new Dimension(50, 20));
        samplesPerPeriodPanel.add(samplesPerPeriodTextField, BorderLayout.CENTER);
        southPanel.add(samplesPerPeriodPanel);
        parameterPanel.add(northPanel, BorderLayout.NORTH);
        parameterPanel.add(southPanel, BorderLayout.SOUTH);
        return parameterPanel;
    }

    public void setDialogValues() {
        setInt(typePanel, RECOMPUTE);
        setInt(alignPanel, ALIGN);
        setFloat(resampleFrequencyTextField, RESAMPLE, 3);
        sampleFrequencyTextField.setText(Float.toString(sampleFrequency));
        setFloat(marginTextField, MARGIN, 3);
        setInt(samplesPerPeriodTextField, SAMPLES_PER_PERIOD);
    }

    public void getDialogValues() {
        recompute = (getInt(typePanel, RECOMPUTE) == 1) ? true : false;
        align = getInt(alignPanel, ALIGN);
        resampleFrequency = parseFloat(resampleFrequencyTextField, RESAMPLE);
        sampleFrequency = parseFloat(sampleFrequencyTextField, 1);
        margin = parseFloat(marginTextField, MARGIN);
        samplesPerPeriod = parseInt(samplesPerPeriodTextField, SAMPLES_PER_PERIOD, 1, 10);
    }

    /**
     * Method to initialize the process
     * 
     * @result boolean - whether or not the process can start
     */
    public boolean initProcess() {
        first = true;
        initialResampleFrequency = resampleFrequency;
        resampleLength = 0;
        resampleFrequency = 0;
        shift = 0;
        fftSize = 0;
        if (initialResampleFrequency == 1.0f && margin == 0.1f) { // default values -> just find strongest frequency
            initialResampleFrequency = sampleFrequency / 2;
            margin = 1;
        }
        if (initialResampleFrequency > sampleFrequency / 2 && sampleFrequency != 1) {
            err("ERROR: Resample frequency must be equal or less than half of the sample frequency");
            currentTraceIndex = NO_TRACE;
            return false;
        }
        if (margin < 0 || margin > 1) {
            err("ERROR: margin must be in the range 0..1");
            return false;
        }
        if (samplesPerPeriod < 1 || samplesPerPeriod * initialResampleFrequency > sampleFrequency && sampleFrequency != 1) {
            err("ERROR, invalid number of samples per period, should be at least 1, but reduce the number of result samples");
            return false;
        }
        return true;
    }

    boolean computeFrequency(Trace t, float initialResampleFrequency) throws DataOperationException {
        boolean result;

        if (fftSize < t.getNumberOfSamples()) {
            fftSize = 1;
            while (fftSize < t.getNumberOfSamples()) {
                fftSize <<= 1;
            }
        }
        float[] freq;
        float[] sample = new float[fftSize];
        System.arraycopy(t.getSample(), 0, sample, 0, t.getNumberOfSamples());

        Data data = operation.createData(sample);
        data = operation.r2hc(data);
        data = operation.normalize(data, fftSize);
        data = operation.hc2amplitude(data, fftSize);

        freq = data.getFloatData();

        int estimate = (int) (fftSize * initialResampleFrequency / sampleFrequency);
        int low = (int) (estimate * (1 - margin));
        if (low <= 0) {
            low = 1;
        }
        int high = (int) (estimate * (1 + margin));
        resampleFrequencyIndex = estimate;
        float max = freq[estimate];
        for (int i = low; i < high && i < freq.length; i++) {
            if (i == low || freq[i] > max) {
                max = freq[i];
                resampleFrequencyIndex = i;
            }
        }
        if (margin == 0) {
            resampleFrequency = initialResampleFrequency;
        } else {
            resampleFrequency = resampleFrequencyIndex * sampleFrequency / fftSize;
        }
        period = sampleFrequency / resampleFrequency;
        factor = samplesPerPeriod / period;
        intPeriod = (int) Math.ceil(period);
        halfPeriod = (int) Math.ceil(period / 2);
        comparePeriod = (int) Math.ceil(10 * period);
        halfComparePeriod = (int) Math.ceil(5 * period);
        resampleLength = (int) Math.ceil(numberOfSamples * factor);
        if (resampleLength <= 1) {
            err("WARNING: Resample frequency (" + initialResampleFrequency + ") is too low, cannot resample");
            result = false;
        } else {
            out("Resample frequency: " + resampleFrequency);
            result = true;
        }
        return result;
    }

    int getShift(float[] sample) {
        int peakIndex = 0;
        float peakValue = 0;
        for (int i = shiftLow; i < shiftHigh; i++) {
            if (i == shiftLow || sample[i] > peakValue) {
                peakIndex = i;
                peakValue = sample[i];
            }
        }
        return peakIndex;
    }

    int computeFirstAlignment(float[] sample) {
        if (align == PEAK_ALIGN) {
            shiftLow = sample.length / 2 - halfPeriod;
            shiftHigh = shiftLow + intPeriod;
        } else { // CORRELATION_ALIGN
            shiftLow = sample.length / 2 - halfComparePeriod;
            shiftHigh = shiftLow + comparePeriod;
        }
        if (shiftLow < 0)
            shiftLow = 0;
        if (shiftHigh >= sample.length)
            shiftHigh = sample.length - 1;
        int shift = getShift(sample);
        int periods = (int) (shift / period);
        int peakPositionInPeriod = (int) (shift - periods * period);
        int correction = (int) (Math.ceil(period / 8) - peakPositionInPeriod); // peak projected at 12.5% of period
        return shift + correction; // assume peak is a 12.5% of period
    }

    protected void createReference(float[] sample) throws DataOperationException {
        fftSize = 1;
        while (fftSize < comparePeriod)
            fftSize <<= 1;
        float[] refSample = new float[fftSize];
        testSample = new float[fftSize];
        for (int i = shiftLow, j = 0; j < comparePeriod; i++, j++)
            refSample[j] = sample[i];
        sr = new float[comparePeriod];
        s2r = new float[comparePeriod];
        getStats(refSample, sr, s2r, intPeriod, intPeriod);

        Data data = operation.createData(refSample);
        data = operation.r2hc(data);
        data = operation.normalize(data, fftSize);
        refFreq = data.getFloatData();
    }

    /**
     * compute sum of samples
     * 
     * @param in - input trace
     * @param length - length of input trace
     * @return the sum
     */
    protected double getSum(float[] in, int length) {
        double sum = 0;
        for (int i = 0; i < length; i++)
            sum += in[i];
        return sum;
    }

    /**
     * compute non-normalized variance of trace
     * 
     * @param in - input trace
     * @param sum - sum of input samples
     * @param length - length of input trace
     * @return the non-normalized variance
     */
    protected double getVar(float[] in, double sum, int length) {
        double sumOfSquares = 0;
        for (int i = 0; i < length; i++)
            sumOfSquares += in[i] * in[i];
        return sumOfSquares - sum * sum / length;
    }

    /**
     * compute sum and non-normalized variance for all fragments within a trace
     * 
     * @param in - input trace
     * @param s - output sum of input samples
     * @param s2 - output non-normalized variance of input samples
     * @param len1 - length of fragments
     * @param len2 - number of fragments
     */
    protected void getStats(float[] in, float[] s, float[] s2, int len1, int len2) {
        for (int i = 0; i < s.length; i++) {
            s[i] = in[i];
            s2[i] = s[i] * s[i];
        }
        double s0 = s[0], s20 = s2[0];
        for (int i = 1; i < len1 && i < s.length; i++) {
            s[0] += s[i];
            s2[0] += s2[i];
        }
        for (int i = 1, j = len1, k = 0; i < len2; i++, j++, k++) {
            double sn = s[i], s2n = s2[i];
            s[i] = (float) (s[k] - s0 + s[j]);
            s2[i] = (float) (s2[k] - s20 + s2[j]);
            s0 = sn;
            s20 = s2n;
        }
        for (int i = 0; i < len2; i++)
            s2[i] -= s[i] * s[i] / len1;
    }

    /**
     * compute correlation between fragment and reference trace
     * 
     * @param p1 - FFT plan time -> frequency
     * @param p2 - FFT plan frequency -> time
     * @param xf - reference trace in frequency domain
     * @param sx - sum of reference trace values
     * @param s2x - non-normalized variance of reference trace values
     * @param y - trace fragment to correlate
     * @param len - length of trace fragment to correlate
     * @throws DataOperationException
     */
    protected float[] correlation(float[] xf, float[] sx, float[] s2x, float[] y, int len)
            throws DataOperationException {
        double sy = getSum(y, len);
        double s2y = getVar(y, sy, len);

        Data data = operation.createData(y);

        float[] yf = operation.r2hc(data).getFloatData();
        yf[0] *= xf[0];
        for (int i = 1, j = xf.length - 1; i < j; i++, j--) { // multiply transforms
            double s1 = xf[i];
            double s2 = yf[i];
            double s3 = xf[j];
            double s4 = yf[j];
            yf[j] = (int) (s3 * s2 - s1 * s4);
            yf[i] = (int) (s1 * s2 + s3 * s4);
        }
        if (xf.length % 2 == 0) /* chosenNumberOfInputSamples is even */
            yf[xf.length / 2] = xf[xf.length / 2] * yf[xf.length / 2]; /* Nyquist freq. */
        float[] c = operation.hc2r(operation.createData(yf)).getFloatData();
        if (s2y > 0)
            for (int i = 0; i < intPeriod; i++) {
                if (s2r[i] > 0)
                    c[i] = (float) ((c[i] - sx[i] * sy / len) / Math.sqrt(s2x[i] * s2y));
                else
                    c[i] = 0;
            }
        return c;
    }

    int getBestCorrelation(float[] sample) throws DataOperationException {
        float[] testSample = new float[fftSize];
        //for ( int i = 0, j = shiftLow + halfPeriod; i < intPeriod; i++, j++ )
        for (int i = 0, j = shiftLow; i < comparePeriod; i++, j++)
            testSample[i] = sample[j];
        float[] c = correlation(refFreq, sr, s2r, testSample, intPeriod);
        int bestCorrelationIndex = 0;
        float bestCorrelation = c[0];
        for (int i = 1; i < intPeriod; i++) {
            if (c[i] > bestCorrelation) {
                bestCorrelation = c[i];
                bestCorrelationIndex = i;
            }
        }
        return shiftLow + halfPeriod - bestCorrelationIndex;
    }

    /**
     * Method for processing a single trace
     * 
     * @param t Trace to process
     * @return resulting Trace
     * @throws DataOperationException
     */
    public Trace process(Trace t) throws DataOperationException {
        if (first || recompute) {
            if (!computeFrequency(t, initialResampleFrequency))
                return null;
        }
        if (align != NO_ALIGN) {
            if (first) {
                firstShift = computeFirstAlignment(t.getSample());
                if (align == CORRELATION_ALIGN)
                    createReference(t.getSample());
            }
            if (align == CORRELATION_ALIGN) {
                shift = getBestCorrelation(t.getSample()) - firstShift;
            } else if (align == PEAK_ALIGN) {
                shift = getShift(t.getSample()) - firstShift;
            }
            //out("shift: "+shift);
        }
        if (resampleFrequency == 0 || resampleLength <= 1)
            return null; // should not happen
        float[] resample = new float[resampleLength];
        int k = 0, last_j = 0;
        for (int i = 0, p = t.getNumberOfSamples() + shift; i < t.getNumberOfSamples(); i++, k++, p++) {
            int j = (int) (i * factor);
            if (j > last_j && k > 0) {
                resample[last_j] /= k;
                k = 0;
            }
            if (j < resampleLength)
                resample[j] += t.getSample(p % t.getNumberOfSamples());
            last_j = j;
        }
        if (k > 0 && last_j < resampleLength)
            resample[last_j] /= k;
        first = false;
        return new Trace(t.getTitle(), t.getData(), resample, resampleFrequency * samplesPerPeriod);
    }

}
