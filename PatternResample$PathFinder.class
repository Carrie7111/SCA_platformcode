        /* Frequency panel */
        frequencyPanel = new JPanel();
        frequencyPanel.setLayout(new BorderLayout());
        frequencyPanel.setBorder(new TitledBorder("Frequency"));

        sampleFrequencyTextField = new JTextField(String.valueOf(sampleFrequency));
        //sampleFrequencyTextField.setPreferredSize(new Dimension(90, 20));
        sampleFrequencyTextField.setToolTipText("Sample frequency of input traces");
        frequencyPanel.add(sampleFrequencyTextField, BorderLayout.NORTH);

        /* Resample panel */
        resamplePanel = new JPanel();
        resamplePanel.setLayout(new BorderLayout());
        resamplePanel.setBorder(new TitledBorder("Resample"));

        resampleFrequencyTextField = new JTextField(String.valueOf(resampleFrequency));
        resampleFrequencyTextField.setPreferredSize(new Dimension(90, 20));
        resampleFrequencyTextField.setToolTipText("Frequency used for resampling traces");
        resamplePanel.add(resampleFrequencyTextField, BorderLayout.NORTH);

        /* Margin panel */
        marginPanel = new JPanel();
        marginPanel.setLayout(new BorderLayout());
        marginPanel.setBorder(new TitledBorder("Margin"));
        marginTextField = new JTextField(String.valueOf(margin));
        marginTextField.setPreferredSize(new Dimension(50, 20));
        marginTextField.setToolTipText("Allowed deviation of estimated resample frequency");
        marginPanel.add(marginTextField, BorderLayout.NORTH);

        /* Parameter panel */
        parameterPanel = new JPanel();
        parameterPanel.setLayout(new GridLayout(1, 3));
        parameterPanel.add(frequencyPanel);
        parameterPanel.add(resamplePanel);
        parameterPanel.add(marginPanel);

        /* Synchronization panel */
        synchronizePanel = new JPanel();
        synchronizePanel.setLayout(new GridLayout(5, 1));
        synchronizePanel.setBorder(new TitledBorder("Synchronize at"));

        ButtonGroup peakGroup = new ButtonGroup();
        positivePeakButton = new JRadioButton("Positive peak");
        positiveAbsPeakButton = new JRadioButton("Positive ABS peak");
        negativePeakButton = new JRadioButton("Negative peak");
        positiveEdgeButton = new JRadioButton("Positive edge");
        negativeEdgeButton = new JRadioButton("Negative edge");
        positiveAbsPeakButton.setSelected(true);
        peakGroup.add(positivePeakButton);
        peakGroup.add(positiveAbsPeakButton);
        peakGroup.add(negativePeakButton);
        peakGroup.add(positiveEdgeButton);
        peakGroup.add(negativeEdgeButton);
        synchronizePanel.add(positivePeakButton);
        synchronizePanel.add(positiveAbsPeakButton);
        synchronizePanel.add(negativePeakButton);
        synchronizePanel.add(positiveEdgeButton);
        synchronizePanel.add(negativeEdgeButton);

        /* Start panel */
        startPanel = new JPanel();
        startPanel.setLayout(new BorderLayout());
        startPanel.setBorder(new TitledBorder("Start %"));
        startTextField = new JTextField("0.0");
        startPanel.add(startTextField);

        /* End panel */
        endPanel = new JPanel();
        endPanel.setLayout(new BorderLayout());
        endPanel.setBorder(new TitledBorder("End %"));
        endTextField = new JTextField("100.0");
        endPanel.add(endTextField);

        /* Partition panel */
        partitionPanel = new JPanel();
        partitionPanel.setLayout(new GridLayout(2, 1));
        partitionPanel.setBorder(new TitledBorder("Select partition of clock cycle"));
        partitionPanel.add(startPanel);
        partitionPanel.add(endPanel);

        /* Signal processing panel */
        processingPanel = new JPanel();
        processingPanel.setLayout(new GridLayout(5, 1));
        processingPanel.setBorder(new TitledBorder("Signal processing"));

        ButtonGroup processingGroup = new ButtonGroup();
        procAverageButton = new JRadioButton("Average");
        procAbsAverageButton = new JRadioButton("ABS + Average");
        procIntegrateAverageButton = new JRadioButton("Integrate + Average");
        procIntegrate2AverageButton = new JRadioButton("Integrate twice + Average");
        procRMSButton = new JRadioButton("Root Mean Square");
        procAbsAverageButton.setSelected(true);
        processingGroup.add(procAverageButton);
        processingGroup.add(procAbsAverageButton);
        processingGroup.add(procIntegrateAverageButton);
        processingGroup.add(procIntegrate2AverageButton);
        processingGroup.add(procRMSButton);
        processingPanel.add(procAverageButton);
        processingPanel.add(procAbsAverageButton);
        processingPanel.add(procIntegrateAverageButton);
        processingPanel.add(procIntegrate2AverageButton);
        processingPanel.add(procRMSButton);

        /* Extra panel that contains the Partition panel & Synchronization panel */
        JPanel tmp = new JPanel();
        tmp.setLayout(new GridLayout(1, 2));
        tmp.add(partitionPanel);
        tmp.add(synchronizePanel);

        /* Main panel */
        mainPanel = new JPanel();
        mainPanel.setLayout(new BorderLayout());
        mainPanel.add(parameterPanel, BorderLayout.NORTH);
        mainPanel.add(tmp, BorderLayout.CENTER);
        mainPanel.add(processingPanel, BorderLayout.SOUTH);

        return mainPanel;
    }

    /**
     * Parameterize the dialog of the module set the displayed values of your dialog components here
     */
    public void setDialogValues() {
        setInt(synchronizePanel, PEAK);
        setInt(processingPanel, PROCESS);
        setFloat(resampleFrequencyTextField, RESAMPLE, 3);
        sampleFrequencyTextField.setText(Float.toString(sampleFrequency));
        setFloat(marginTextField, MARGIN, 3);
        setFloat(startTextField, START_PARTITION, 3);
        setFloat(endTextField, END_PARTITION, 3);
    }

    /**
     * Get values entered in the dialog of the module get the displayed values of your dialog components here
     */
    public void getDialogValues() {
        synchronizationType = getInt(synchronizePanel, PEAK);
        processingType = getInt(processingPanel, PROCESS);
        resampleFrequency = parseFloat(resampleFrequencyTextField, RESAMPLE);
        sampleFrequency = parseFloat(sampleFrequencyTextField, 1);
        margin = parseFloat(marginTextField, MARGIN);
        startPartition = parseFloat(startTextField, START_PARTITION) / 100;
        endPartition = parseFloat(endTextField, END_PARTITION) / 100;
    }

    /**
     * Get the memory requirements for this module
     * 
     * @return memory required for module
     */
    public long getRequiredMemorySize() {
        return 0; // return required number of bytes here
    }

    /**
     * Initialize the process Create objects needed during the module process here
     * 
     * @return whether or not the process can start
     */
    public boolean initProcess() {
        initialResampleFrequency = resampleFrequency;
        resampleLength = 0;
        orgLength = 0;
        fftSize = 0;
        if (resampleFrequency > sampleFrequency && sampleFrequency != 1) {
            err("WARNING: Resample frequency must be lower than sample frequency");
            return false;
        }
        if (margin < 0 || margin >= 1) {
            err("ERROR: margin must be in the range 0..1");
            return false;
        }

        return true;
    }

    private int getPeakIndex(Trace t, int offset, int length, int synchronizationType) {
        if (offset < 0) {
            offset = 0;
        }

        if (offset >= t.getNumberOfSamples()) {
            offset = t.getNumberOfSamples() - 1;
        }

        if (offset + length >= t.getNumberOfSamples()) {
            length = t.getNumberOfSamples() - offset;
        }

        float value = 0;
        int index = offset;

        for (int i = offset; i < offset + length; i++) {
            if (synchronizationType == PEAK_NEG) { // negative peak
                float currentValue = (float) ((t.getSample(i) - t.getSample(offset)) / (1.0 + (Math.abs(i - (offset + length / 2.0)) / (length / 2.0))));
                if (currentValue < value) {
                    value = currentValue;
                    index = i;
                }
            } else if (synchronizationType == PEAK_POS) { // positive peak
                float currentValue = (float) ((t.getSample(i) - t.getSample(offset)) / (1.0 + (Math.abs(i - (offset + length / 2.0)) / (length / 2.0))));
                if (currentValue > value) {
                    value = currentValue;
                    index = i;
                }
            } else if (synchronizationType == PEAK_POS_ABS) { // positive peak in abs signal
                float currentValue = Math.abs(t.getSample(i)) ;
                if (currentValue > value) {
                    value = currentValue;
                    index = i;
                }
            } else if (synchronizationType == EDGE_POS) { // positive edge (through 0)
                if (i > 0 && t.getSample(i - 1) < 0 && t.getSample(i) >= 0) {
                    index = i;
                }
            } else if (synchronizationType == EDGE_NEG) { // negative edge (through 0)
                if (i > 0 && t.getSample(i - 1) > 0 && t.getSample(i) <= 0) {
                    index = i;
                }
            } else {
                err("FATAL ERROR: Unknown synchronization type!");
                break;
            }
        }

        return index;
    }

    /**
     * Method for processing a single trace this method will be called if you set variable numberOfResultTraces
     * 
     * @param t Trace to process
     * @return resulting Trace
     * @throws DataOperationException
     */
    public Trace process(Trace t) throws DataOperationException {
        if (resampleFrequency == 0) {
            err("ERROR: Enter a valid resample frequency first");
            return null;
        }

        float[] integrate = new float[t.getNumberOfSamples()];
        float[] integrate2 = new float[t.getNumberOfSamples()];
        float[] resample;

        if (orgLength != t.getNumberOfSamples())
            computeFrequency(t, initialResampleFrequency);

        resample = new float[resampleLength + 1];

        float floatSamplesPerClockCycle = ((1 / resampleFrequency) / xScale);
        int samplesPerClockCycle = Math.round(floatSamplesPerClockCycle);
        float floatCurrentIndex = getPeakIndex(t, 2 * samplesPerClockCycle, 3 * samplesPerClockCycle, synchronizationType);
        int currentIndex = Math.round(floatCurrentIndex);
        if (currentIndex > 3 * samplesPerClockCycle) currentIndex -= samplesPerClockCycle;
        if (currentIndex > 3 * samplesPerClockCycle) currentIndex -= samplesPerClockCycle;
        float averageDeviation = 0;

        int k = 0;
        while (currentIndex + 2 * samplesPerClockCycle < t.getNumberOfSamples() && k < resample.length) {
            /* Determine exact starting position of current clock cycle... */
            int peakIndex = getPeakIndex(t, currentIndex - Math.round(floatSamplesPerClockCycle / 2), samplesPerClockCycle,
                    synchronizationType);
            int startIndex = peakIndex + Math.round(startPartition * samplesPerClockCycle);
            int endIndex = peakIndex + Math.round(endPartition * samplesPerClockCycle);
            int length = 0;

            if (startIndex < 0)
                startIndex = 0;

            if (endIndex >= t.getNumberOfSamples())
                endIndex = t.getNumberOfSamples() - 1;

            length = endIndex - startIndex;

            if (length <= 0) {
                err("ERROR: No samples in partition! Please select a larger partition of the clock cycle or reduce the resample frequency.");
                aborted = true;
                return null;
            }

            /* Process current partition based on selected processing technique */
            switch (processingType) {
                case PROC_AVERAGE:
                    for (int i = startIndex + 1; i < endIndex - 1; i++) {
                        resample[k] += t.getSample(i);
                    }
                    resample[k] += t.getSample(startIndex) / 2;
                    resample[k] += t.getSample(endIndex) / 2;
                    break;

                case PROC_ABS_AVERAGE:
                    for (int i = startIndex + 1; i < endIndex - 1; i++)
                        resample[k] += (t.getSample(i) >= 0) ? t.getSample(i) : -t.getSample(i);

                    resample[k] += ((t.getSample(startIndex) >= 0) ? t.getSample(startIndex) : -t.getSample(startIndex)) / 2;
                    resample[k] += ((t.getSample(endIndex) >= 0) ? t.getSample(endIndex) : -t.getSample(endIndex)) / 2;
                    break;

                case PROC_INTEGRATE_AVERAGE:
                    integrate[0] = 0;

                    for (int i = 0; i < length; i++) {
                        integrate[i + 1] = integrate[i] + t.getSample(startIndex + i);
                        resample[k] += integrate[i + 1];
                    }
                    break;

                case PROC_INTEGRATE_TWICE_AVERAGE:
                    integrate[0] = 0;
                    integrate2[0] = 0;

                    for (int i = 0; i < length; i++) {
                        integrate[i + 1] = integrate[i] + t.getSample(startIndex + i);
                        integrate2[i + 1] = integrate2[i] + integrate[i];
                        resample[k] += integrate2[i + 1];
                    }
                    break;

                case PROC_RMS:
                    if (endIndex >= startIndex + 3) {
                        for (int i = startIndex + 1; i < endIndex - 1; i++) {
                            resample[k] += t.getSample(i) * t.getSample(i);
                        }
                    }
                    resample[k] += (t.getSample(startIndex) / 2) * (t.getSample(startIndex) / 2);
                    resample[k] += (t.getSample(endIndex) / 2) * (t.getSample(endIndex) / 2);
                    resample[k] /= length;
                    resample[k] = (float) Math.sqrt(resample[k]);
                    resample[k] *= length;
                    break;
            }

            resample[k] /= length;

            /* Move to the estimated position of the next clock cycle */
            averageDeviation += margin * (peakIndex - currentIndex);
            floatCurrentIndex += floatSamplesPerClockCycle + margin * (peakIndex - currentIndex);
            currentIndex = Math.round(floatCurrentIndex);
            k++;
        }

        return new Trace(t.getTitle(), t.getData(), resample, resampleFrequency);
    }

    void computeFrequency(Trace t, float initialResampleFrequency) throws DataOperationException {
        orgLength = t.getNumberOfSamples();
        resampleFrequency = 0;
        sampleFrequency = t.sampleFrequency;
        if (initialResampleFrequency > sampleFrequency) {
            err("ERROR: Resample frequency (" + initialResampleFrequency + ") must be lower than sample frequency (" + sampleFrequency + ")");
            return;
        }
        fftSize = 1;
        while (fftSize < t.getNumberOfSamples()) {
            fftSize <<= 1;
        }
        float[] freq;
        float[] sample = new float[fftSize];
        System.arraycopy(t.getSample(), 0, sample, 0, t.getNumberOfSamples());

        Data data = operation.createData(sample);
        data = operation.r2hc(data);
        data = operation.normalize(data, fftSize);
        data = operation.hc2amplitude(data, fftSize);
        
        freq = data.getFloatData();

        int estimate = Math.round(fftSize * initialResampleFrequency / sampleFrequency);
        int low = Math.round(estimate * (1.0f - margin));
        int high = Math.round(estimate * (1.0f + margin));
        int best = estimate;
        float max = freq[estimate];
        for (int i = low; i < high && i < freq.length; i++) {
            if (i == low || freq[i] > max) {
                max = freq[i];
                best = i;
            }
        }
        if (margin == 0) {
            resampleFrequency = initialResampleFrequency;
        } else {
            resampleFrequency = best * sampleFrequency / fftSize;
        }
        factor = resampleFrequency / sampleFrequency;
        resampleLength = (int) (Math.ceil(t.getNumberOfSamples() * factor));
        out("Resample frequency: " + resampleFrequency);
    }
}
