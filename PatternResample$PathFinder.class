@SuppressWarnings("serial")
@ModuleDesc(pkgName="Resample", name="SyncResample", desc="",isVisible=false)
public class SyncResample extends Module implements ModuleInChain {
    public static final String RESAMPLE = "resample";
    public static final String PROCESS = "process";
    public static final String PEAK = "peak";
    public static final String MARGIN = "margin";
    public static final String START_PARTITION = "startPartition";
    public static final String END_PARTITION = "endPartition";
    private static final int PROC_AVERAGE = 0;
    private static final int PROC_ABS_AVERAGE = 1;

    private static final int PROC_INTEGRATE_AVERAGE = 2;
    private static final int PROC_INTEGRATE_TWICE_AVERAGE = 3;
    private static final int PROC_RMS = 4;

    private static final int PEAK_POS = 0;
    private static final int PEAK_POS_ABS = 1;
    private static final int PEAK_NEG = 2;
    private static final int EDGE_POS = 3;
    private static final int EDGE_NEG = 4;

    private JPanel mainPanel;
    private JPanel parameterPanel, frequencyPanel, resamplePanel, marginPanel;
    private JPanel synchronizePanel;
    private JPanel partitionPanel, startPanel, endPanel;
    private JPanel processingPanel;
    private JTextField sampleFrequencyTextField;
    private JTextField resampleFrequencyTextField;
    private JTextField startTextField;
    private JTextField endTextField;
    private JTextField marginTextField;
    private JRadioButton positivePeakButton, negativePeakButton, positiveEdgeButton, negativeEdgeButton,
            positiveAbsPeakButton;
    private JRadioButton procAverageButton, procAbsAverageButton, procIntegrateAverageButton,
            procIntegrate2AverageButton, procRMSButton;

    private float initialResampleFrequency, resampleFrequency, margin, factor;
    public int fftSize, resampleLength, orgLength;

    private int processingType;
    private int synchronizationType = PEAK_POS;
    private float startPartition;
    private float endPartition;

    /**
     * Initialize the module define module specific value here
     */
    public void initModule() {
        moduleTitle = "SyncResample";
        prefix = "Resampled (sync) ";
        moduleDescription = "Resample traces at another frequency (with synchronisation)";
        helpFile = "doc/manual/modulesSyncResample.html";

        synchronizationType = PEAK_POS;

        startPartition = -5;
        endPartition = 5;
        margin = 0.1f;
        processingType = PROC_AVERAGE;
        set(PROCESS, processingType);
        set(PEAK, synchronizationType);
        set(RESAMPLE, resampleFrequency);
        set(MARGIN, margin);
        set(START_PARTITION, startPartition);
        set(END_PARTITION, endPartition);
    }

