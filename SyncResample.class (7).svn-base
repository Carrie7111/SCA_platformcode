     * @parameter int sft - suggested first trace to process
     * @parameter int snt - suggested number of traces to process
     * @parameter int sfs - suggested first sample to process
     * @parameter int sns - suggested number of samples to process
     */
    public void setDialogValues(Trace t, int nt, int sft, int snt, int sfs, int sns) {
        setDialogValues();
        ns = t.getNumberOfSamples();
    }
    
    public void setDialogValues() {
        setInt(actionPanel, ACTION);
        setInt(alignPanel, ALIGN);
        setInt(methodPanel, DETECTION_METHOD);
        setFloat(thresholdTextField, THRESHOLD, 4);
        setInt(beginIndexTextField, BEGIN_INDEX);
        setInt(endIndexTextField, END_INDEX);
        setInt(minDistanceTextField, DISTANCE_MINIMAL);
        setInt(maxDistanceTextField, DISTANCE_MAXIMAL);
        setInt(startCompressionTextField, COMPRESSION_START);
        setInt(endCompressionTextField, COMPRESSION_END);
        setString(patternTraceTextField, PATTERN_FILE_PATH );
