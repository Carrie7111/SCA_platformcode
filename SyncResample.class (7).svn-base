    }

    public void getDialogValues() {
        action = getInt(actionPanel, ACTION);
        align = getInt(alignPanel, ALIGN);
        detectionMethod = getInt(methodPanel, DETECTION_METHOD);
        threshold = parseFloat(thresholdTextField, THRESHOLD);
        beginIndex = parseInt(beginIndexTextField, BEGIN_INDEX);
        endIndex = parseInt(endIndexTextField, END_INDEX);
        minDistance = parseInt(minDistanceTextField, DISTANCE_MINIMAL);
        maxDistance = parseInt(maxDistanceTextField, DISTANCE_MAXIMAL);
        beginCompression = parseInt(startCompressionTextField, COMPRESSION_START);
        endCompression = parseInt(endCompressionTextField, COMPRESSION_END);
        patternFilePath = getString( patternTraceTextField, PATTERN_FILE_PATH );
    }

    /**
     */
    public boolean initProcess() throws DataOperationException {
        selectionStart = firstSampleIndex;
        selectionEnd = firstSampleIndex+numberOfSamples;
        recentTraceIndex = 0;
        patterns = 0;
        // restore original dimensions to get all samples of the traces
        firstSampleIndex = 0;
        numberOfSamples = ns;
        fftCorrelationSize = 1;
        while (fftCorrelationSize < numberOfSamples)
            fftCorrelationSize <<= 1;
        fftSpectrumSize = fftCorrelationSize > numberOfSamples ? fftCorrelationSize >> 1 : fftCorrelationSize;
        sy = new double[fftCorrelationSize];
        s2y = new double[fftCorrelationSize];
        if (action == CORRELATE) {
            yScale = 1;
            yLabel = null;
            prefix = "Correlated with pattern";
            averageSpectrum = new float[1+fftCorrelationSize/2];
            selectWindow = false;
        } else {
            prefix = "Pattern resampled";
            selectWindow = true;
            if (selectionStart == 0 && selectionEnd == numberOfSamples) { // no selection was made yet
                selectionStart = beginIndex;
                selectionEnd = Math.min( endIndex, numberOfSamples );
            }
        }
        if (!loadPattern(patternFilePath))
            return false;
        return true;
    }

    protected boolean loadPattern(String fileName) {
        try {
            if (fileName == null || fileName.length() == 0) {
                err("No pattern trace set selected");
                return false;
            }
            File traceSetFile = new File(traceSetPath, fileName);
            if (!traceSetFile.exists()) {
                traceSetFile = new File(fileName);
                if (!traceSetFile.exists()) {
                    err("File " + fileName + " does not exist");
                    return false;
                }
            }
            TraceSet ts = new TraceSet(traceSetFile.getPath());
            int tsLength = ts.getNumberOfSamples();
            if (tsLength < numberOfSamples) { // pattern defined by trace dimensions
                patternStart = 0;
                patternLength = tsLength;
                out("Pattern length: "+patternLength+" (defined by loaded pattern)");
            }
            else { // pattern defined by selection
                patternStart = selectionStart;
                patternLength = selectionEnd - selectionStart;
                if (action == FILTER) {
                    selectionStart = beginIndex;
                    selectionEnd = Math.min( endIndex, numberOfSamples );
                }
                out("Pattern length: "+patternLength+" (defined by selection)");
            }
            Trace t = ts.getTrace(0); // pattern must be in first trace
            float[] sample = t.getSample();
            ts.close();
            pattern = new double[fftCorrelationSize]; // create reference float array
            for (int i = 0, j = patternStart; i < patternLength; i++, j++)
                pattern[i] = sample[j];
            sPattern = getSum(pattern, patternLength);
            s2Pattern = getVar(pattern, sPattern, patternLength);
            Data data = operation.r2hc(operation.createData(pattern));
            data = operation.normalize(data, fftCorrelationSize);
            pattern = data.getDoubleData();
        } catch (Exception e) {
            err("Cannot open or read: " + fileName);
            e.printStackTrace();
            return false;
        }
        return true;
    }

    /** Method for processing a single trace
     * @param t Trace to process
     * @return resulting Trace
     */
    public Trace process(Trace t) throws DataOperationException {
        resultTraceIndex = 0;
        recentTraceIndex = currentTraceIndex;
        double[] sample = new double[fftCorrelationSize];
        for (int i = 0; i < t.getNumberOfSamples(); i++)
            sample[i] = t.getSample(i);
        double[] c = correlation(pattern, sPattern, s2Pattern, sample, patternLength);
        float[] result = null;
        if (action == CORRELATE) { // make correlation trace
            result = new float[numberOfSamples];
            for (int i = 0; i < numberOfSamples; i++) {
                result[i] = (float) c[i];
            }
            if (currentTraceIndex == firstTraceIndex) first = c;
            float[] spectrum = getSpectrum(t);
            for (int i = 0; i < spectrum.length; i++) { // keep an average of the spectrum of the trace
                averageSpectrum[i] += spectrum[i];
            }
            if (currentTraceIndex == lastTraceIndex) suggestParameters( first, averageSpectrum );
        } else { // resample
            SortedSet<Integer> set = null;
            if (detectionMethod == DETECT_THRESHOLD) 
                set = findMatches( c, threshold, selectionStart, selectionEnd, 0, endCompression - beginCompression );
            else 
                set = findMatchesWithBackTracking( c, threshold, selectionStart, selectionEnd, 0, endCompression - beginCompression, maxDistance * MAX_DEPTH );
            Integer[] pos = new Integer[set.size()];
            set.toArray(pos);
            int found = pos.length;
            if (patterns == 0) 
                patterns = found;
            out("Trace "+currentTraceIndex+", found "+found+" patterns");
            result = new float[patterns];
            int range = endCompression - beginCompression;
            for ( int i = 0; i < patterns && i < found; i++ ) {
                double d = 0;
                int x = align == LEFT ? i : found - 1 - i;
                int y = align == LEFT ? i : patterns - 1 - i;
                for ( int j = 0; j < range; j++ )
                    d += sample[pos[x]+beginCompression+j];
                result[y] = (float)(d / range);
            }
        }
        return new Trace(t.title, t.data, result);
    }

    /**
     * compute sum of samples
     * 
     * @param in - input trace
     * @param length - length of input trace
     * @return the sum
     */
    protected double getSum(double[] in, int length) {
        double sum = 0;
        for (int i = 0; i < length; i++)
            sum += in[i];
        return sum;
    }

    /**
     * compute non-normalized variance of trace
     * 
     * @param in - input trace
     * @param sum - sum of input samples
     * @param length - length of input trace
     * @return the non-normalized variance
     */
    protected double getVar(double[] in, double sum, int length) {
        double sumOfSquares = 0;
        for (int i = 0; i < length; i++)
            sumOfSquares += in[i] * in[i];
        return sumOfSquares - sum * sum / length;
    }

    /**
     * compute sum and non-normalized variance for all fragments within a trace
     * 
     * @param in - input trace
     * @param s - output sum of input samples
     * @param s2 - output non-normalized variance of input samples
     * @param len1 - length of fragments
     * @param len2 - number of fragments
     */
    protected void getStats(double[] in, double[] s, double[] s2, int len) {
        for (int i = 0; i < s.length; i++)
            s[i] = in[i] * in[i];
        s2[0] = s[0];
        for (int i = 1; i < len && i < s.length; i++)
            s2[0] += s[i];
        for (int i = 1, j = len, k = 0; i < s.length; i++, j++, k++)
            s2[i] = s2[k] - s[k] + s[j % s.length];
        s[0] = in[0];
        for (int i = 1; i < len && i < s.length; i++)
            s[0] += in[i];
        for (int i = 1, j = len, k = 0; i < s.length; i++, j++, k++)
            s[i] = s[k] - in[k] + in[j % s.length];
        for (int i = 0; i < s.length; i++)
            s2[i] -= s[i] * s[i] / len;
    }

    /**
     * compute correlation between fragment and reference trace
     * 
     * @param p1 - FFT plan time -> frequency
     * @param p2 - FFT plan frequency -> time
     * @param xf - reference trace in frequency domain
     * @param sx - sum of reference trace values
     * @param s2x - non-normalized variance of reference trace values
     * @param y - trace fragment to correlate
     * @param len - length of trace fragment to correlate
     * @throws DataOperationException
     */
    protected double[] correlation(double[] xf, double sx, double s2x, double[] y, int len)
            throws DataOperationException {
        getStats(y, sy, s2y, len);

        double[] yf = operation.r2hc(operation.createData(y)).getDoubleData();
        yf[0] *= xf[0];
        for (int i = 1, j = xf.length - 1; i < j; i++, j--) { // multiply transforms
            double s1 = yf[i];
            double s2 = xf[i];
            double s3 = yf[j];
            double s4 = xf[j];
            yf[j] = (s3 * s2 - s1 * s4);
            yf[i] = (s1 * s2 + s3 * s4);
        }
        if (xf.length % 2 == 0) /* chosenNumberOfInputSamples is even */
            yf[xf.length / 2] = xf[xf.length / 2] * yf[xf.length / 2]; /* Nyquist freq. */
        double[] c = operation.hc2r(operation.createData(yf)).getDoubleData();
        if (s2x > 0)
            for (int i = 0; i < xf.length; i++) {
                if (s2y[i] > 0)
                    c[i] = (c[i] - sx * sy[i] / len) / Math.sqrt(s2x * s2y[i]);
                else
                    c[i] = 0;
            }
        return c;
    }

    /** Find all correlation peaks and return matches
     * @param c correlation calculation 
     * @param threshold Correlation threshold
     * @param beginIndex start of area to scan
     * @param endIndex end of area to scan
     * @param maxNum maximal number of matches
     * @param extractLength 
     * @return SortedSet of match indexes
     */
    private SortedSet<Integer> findMatches(final double[] c, float threshold, int beginIndex, int endIndex, int maxNum, int extractLength ) {
        // Find and sort all peaks descending
        SortedSet<Integer> sortedPeaks = new TreeSet<Integer>(new Comparator<Integer>(){
            @Override
            public int compare(Integer o1, Integer o2) {
                return ((Double)(c[o2])).compareTo(c[o1]);
            }});

        for (int i = beginIndex; i < endIndex; i++)
            if (c[i] >= threshold)
                sortedPeaks.add(i);
        // Create pattern matches highest peak first, nonoverlapping
        SortedSet<Integer> noOverlapPeaks = new TreeSet<Integer>();
        for (Integer peak : sortedPeaks) {
            // Find if this peak is not within the area of a previous peak (left or right)
            // Also check max number of results
            if ((maxNum == 0 || noOverlapPeaks.size() < maxNum) && (noOverlapPeaks.subSet(peak-extractLength+1, peak+extractLength-1).size() == 0)) {
                noOverlapPeaks.add(peak);               
                //out("Match " + (noOverlapPeaks.size()) + " at offset " + peak + " of input trace " + currentTraceIndex + ", correlation: " + c[peak]);
            }
        }
        
        return noOverlapPeaks;
    }
    
    /** Find all correlation peaks and return matches
     * @param c correlation calculation 
     * @param initialThreshold Correlation threshold for peak candidate selection
     * @param beginIndex start of area to scan
     * @param endIndex end of area to scan
     * @param maxNum maximal number of matches
     * @param extractLength 
     * @param maxGap maximal distance to bridge with backtracking 
     * @return SortedSet of match indexes
     */
    private SortedSet<Integer> findMatchesWithBackTracking(final double[] c, float initialThreshold, int beginIndex, int endIndex, int maxNum, int extractLength, int maxGap ) {
        PathFinder pathFinder = new PathFinder( c, minDistance, maxDistance );
        //pathFinder.report = true; // only for testing
        // Find and sort all peaks descending
        SortedSet<Integer> sortedPeaks = new TreeSet<Integer>(new Comparator<Integer>(){
            @Override
            public int compare(Integer o1, Integer o2) {
                return ((Double)(c[o2])).compareTo(c[o1]);
            }});

        for (int i = beginIndex; i < endIndex; i++)
            if (c[i] >= initialThreshold) 
                sortedPeaks.add(i);
        // Create pattern matches highest peak first, nonoverlapping
        SortedSet<Integer> result = new TreeSet<Integer>();
        if (sortedPeaks.isEmpty()) return result;
        int first = sortedPeaks.first();
        int peakToAdd = 0;
        result.add( first );
        sortedPeaks.remove(first);
        double averageCorrelation = c[first];
        int loops = 0;
        boolean go = true;
        // this loop works but could be optimized
        while (!sortedPeaks.isEmpty() && !aborted && go) {
            go = false;
            double localThreshold = averageCorrelation / 2; // each subsequent path should exceed half of the average correlation so far
            //out("threshold: "+localThreshold);
            int[] path = null;
            for (Integer peak : sortedPeaks) {
                // Find if this peak is not within the area of a previous peak (left or right)
                // Also check max number of results
                if ((maxNum == 0 || result.size() < maxNum) && c[peak] >= localThreshold && (result.subSet(peak-extractLength+1, peak+extractLength-1).isEmpty())) {
                    //out("Searching a path for peak: "+peak);
                    SortedSet<Integer> neighborSet = result.headSet(peak); // search peaks before
                    if (!neighborSet.isEmpty()) {
                        int neighbor = neighborSet.last();
                        if (peak - neighbor < maxGap)
                            path = pathFinder.findPath( neighbor, peak, localThreshold );
                    } else {
                        neighborSet = result.tailSet( peak );
                        if (!neighborSet.isEmpty()) {
                            int neighbor = neighborSet.first();
                            if (neighbor - peak < maxGap)
                                path = pathFinder.findPath( peak, neighbor, localThreshold );
                        }
                    }
                }
                if (path != null) {
                    //out("Found a path for peak: "+peak);
                    peakToAdd = peak;
                    break; // break out sortedPeaks loop
                }
            }
            if (path != null) {
                go = true;
                int n = result.size();
                for ( int i = 0; i < path.length; i++ ) {
                    result.add( path[i] );
                    sortedPeaks.remove( path[i] );
                }
                result.add(peakToAdd);
                sortedPeaks.remove(peakToAdd);
                averageCorrelation = (averageCorrelation * n + pathFinder.getCorrelationSum() + c[peakToAdd]) / (n + path.length + 1);
                //out("Average Correlation now: "+averageCorrelation);
            }
        }        
        return result;
    }
    
    /** compute minimal and maximal distance between subsequent matches
    * @param correlationTrace a correlation trace for the selected reference pattern
    * @param threshold the threshold for detecting peaks
    */
    void computeDistanceParameters( float[] averageSpectrum ) {
        // increase base components with their harmonics. This results in a relative amplification of base frequencies
        for ( int i = 2; i < averageSpectrum.length; i++ ) {
            int harmonics = i;
            if (harmonics > MAX_HARMONICS) harmonics = MAX_HARMONICS; // don't take too many harmonics
            for ( int j = 2; j <= harmonics; j++ )
                averageSpectrum[Math.round((float)i/j)] += averageSpectrum[i]/j;
        }
        float max = 0;
        int maxIndex = 0;
        // find the base component as the strongest value
        for ( int i = 105; i < averageSpectrum.length; i++ ) { // skip very low frequent components
            if (averageSpectrum[i] > max) {
                max = averageSpectrum[i];
                maxIndex = i;
                //out("maxIndex now: "+maxIndex+", frequency: "+(maxIndex*xScale));
            }
        } 
        for (maxDistance = maxIndex-1; maxDistance > 0 && averageSpectrum[maxDistance] < averageSpectrum[maxDistance+1]; maxDistance--);
        for (minDistance = maxIndex+1; minDistance < averageSpectrum.length && averageSpectrum[minDistance] < averageSpectrum[minDistance-1]; minDistance++);
        averageDistance = (float)fftSpectrumSize/maxIndex;
        minDistance = fftSpectrumSize/(minDistance-1);
        maxDistance = (int)Math.ceil((float)fftSpectrumSize/(maxDistance+1));
        //out("Pattern repetition frequency: "+(maxIndex/(xScale*fftSpectrumSize))+" Hz");
        out("Average distance between pattern matches: "+averageDistance+", suggested distance between pattern occurences, minimal: "+minDistance+", maximal: "+maxDistance);
        set(DISTANCE_MINIMAL, minDistance);
        set(DISTANCE_MAXIMAL, maxDistance);
        int fraction = patternLength;
        if (averageDistance < patternLength) fraction = (int)averageDistance;
        set(COMPRESSION_START, beginCompression = ((patternLength - fraction)/2));
        set(COMPRESSION_END, endCompression = ((patternLength + fraction)/2));
    }
        
    /** convert signal in time domain to frequency domain
     * @param t Trace to process
     * @return float array of spectrum
     */
    float[] getSpectrum(Trace t) {
        Data data = t.getSampleData();
        data = operation.resizeToPowerOfTwo(data, true); // shrink
        data = operation.smoothen(data, 0, data.getN(), 0.001, 100);
        data = operation.r2hc(data);
        data = operation.normalize(data, fftSpectrumSize);
        float[] sample = data.getFloatData();
        float[] tmp = sample;
        sample = new float[1 + fftSpectrumSize/2];
        int half = (fftSpectrumSize + 1) / 2;
        sample[0] = tmp[0] * tmp[0]; /* DC component */
        for (int k = 1; k < half; ++k)
            /* (k < N/2 rounded up) */
            sample[k] = (float) (tmp[k] * (double) tmp[k] + tmp[fftSpectrumSize - k] * (double) tmp[fftSpectrumSize - k]);
        if (fftSpectrumSize % 2 == 0) /* chosenNumberOfInputSamples is even */
            sample[fftSpectrumSize / 2] = tmp[fftSpectrumSize / 2] * tmp[fftSpectrumSize / 2]; /* Nyquist freq. */
        return sample;
    }    

    /** suggest parameters for the resampling based upon correlation analysis
    * @param correlationTrace a correlation trace for the selected reference pattern
    * @param averageSorted an average sorted correlation trace
    */
    void suggestParameters( double[] correlationTrace, float[] averageSpectrum ) {
        computeDistanceParameters(averageSpectrum);
        SortedSet<Integer> set = null;
        if (detectionMethod == DETECT_THRESHOLD) 
            set = findMatches( correlationTrace, threshold, 0, correlationTrace.length, 0, endCompression - beginCompression );
        else
            set = findMatchesWithBackTracking( correlationTrace, 0.0f, 0, correlationTrace.length, 0, endCompression - beginCompression, maxDistance * MAX_DEPTH );
        Integer[] pos = new Integer[set.size()];
        set.toArray(pos);
        int first = pos.length/2;
        while (first > 0 && pos[first] - pos[first-1] <= maxDistance) first--;
        beginIndex = pos[first];
        int last = pos.length/2;
        while (last < pos.length-1 && pos[last+1] - pos[last] <= maxDistance) last++;
        endIndex = pos[last];
        int matches = last - first + 1;
        threshold = 1;
        for ( int i = first; i <= last; i++ )
            if (correlationTrace[pos[i]] < threshold)
                threshold = (float)correlationTrace[pos[i]]; 
        threshold *= 0.99; // slight correction to threshold to avoid negative effect of casting
        out("Suggested threshold: "+threshold+", number of matches (exceeding this threshold): "+matches+", first match starts at: "+beginIndex+", final match starts at: "+endIndex);
        set(THRESHOLD, threshold);
        beginIndex -= averageDistance/2;
        endIndex += averageDistance/2;
        set( BEGIN_INDEX, beginIndex );
        set( END_INDEX, endIndex );
    }


    class PathFinder { // implements backtracking
        
        int[] winningPath;
        int[] path;
        long calls;
        int stepMin, stepMax, end;
        double[] sample;
        double best;
        public boolean verbose = false; // report intermediate steps
        public boolean report = false; // report final result
        public boolean aborted = false; // interrupt execution
            
        /** Create a new non initialized new PathFinder object
        */
        public PathFinder() {
        }

        /** Create a new PathFinder object for a give correlation array and step bounds
        * @param c double array with correlation values
        * @param stepMin the minimal step to take in the array
        * @param stepMax the maximal step to take in the array
        */
        public PathFinder( double[] sample, int stepMin, int stepMax ) {
            this.sample = sample;
            this.stepMin = stepMin;
            this.stepMax = stepMax;
        }

        /** find the optimal path
        * @param begin where we begin the search
        * @param sum the current accumulated score
        * @param the nest level
        * @return the score at completion
        */
        private double searchPath( int begin, double sum, int index ) {
            calls++;
            int section = end - begin;
            int range = stepMax - stepMin;
            int mod = section % stepMin;
            int div = section / stepMin;
            if (div * range < mod) {
                if (verbose) out("rejected path: "+path2String( path, index )+" for not fit");
                return 0; // no fit
            }
            if (sum + div - 1 < best) {
                if (verbose) out("rejected path: "+path2String( path, index )+" for bad score: "+sum);
                return 0; // won't win
            }
            if (section >= stepMin && section <= stepMax) { // we reached the end
                winningPath = Arrays.copyOf(path,index);
                if (verbose) out("possible path: "+path2String( path, index )+" has score: "+sum);
                return sum; // found match
            }
            for ( int i = 0, j = begin+stepMin; i <= range && !aborted; i++, j++ ) {
                path[index] = j;
                double v = searchPath( j, sum + sample[j], index+1 );
                if (v > best) { // register this optimal score
                    best = v;
                }
            }
            return best;    
        }
        
        /** find an optimal path through an array of values
        * @param begin where we begin the search
        * @param end where we begin the search
        * @param threshold threshold for finding a path
        * @return a boolean indicating succes
        */
        public int[] findPath( int begin, int end, double threshold ) {
            calls = 0;
            long time = System.currentTimeMillis();
            this.end = end;
            best = 0;
            int depth = ((end-begin)/stepMin)+1;
            path = new int[depth];
            winningPath = null;
            best = searchPath( begin, 0, 0 );
            time = System.currentTimeMillis() - time;
            if (verbose) out("Calls: "+calls+", Time diff: "+time);
            if (report) {
                if (winningPath != null) {
                    if (winningPath.length == 0)
                        out("Accepted, neighbor points");
                    else if (best/winningPath.length >= threshold)
                        out("Accepted, path: "+path2String( winningPath )+", av. cor: "+best/winningPath.length+" > "+threshold+" (threshold)");
                    else 
                        out("Rejected, path: "+path2String( winningPath )+", av. cor: "+best/winningPath.length+" < "+threshold+" (threshold)");
                }
                else out("Rejected, no path");
            }
            if (winningPath != null && winningPath.length > 0 && best/winningPath.length < threshold) return null;
            return winningPath; //(winningPath != null && (winningPath.length == 0 || best/winningPath.length >= threshold));
        }
        
        /** find an optimal path through an array of values
        * @param c double array with correlation values
        * @param begin where we begin the search
        * @param end where we begin the search
        * @param stepMin the minimal step to take in the array
        * @param stepMax the maximal step to take in the array
        * @param threshold threshold for finding a path
        * @return a boolean indicating succes
        */
        public int[] findPath( double[] sample, int begin, int end, int stepMin, int stepMax, float threshold ) {
            this.sample = sample;
            this.stepMin = stepMin;
            this.stepMax = stepMax;
            return findPath( begin, end, threshold );
        }

        public double getCorrelationSum() {
            return best;
        }
        
        /** test the path finder algorithm
        */    
        public void test() {
            verbose = true;
            report = true;
            java.util.Random random = new java.util.Random();
            double[] mySample = new double[100];
            for ( int i = 0; i < mySample.length; i++ ) mySample[i] = random.nextFloat();
            findPath( mySample, 0, mySample.length-1, 9, 10, 0f );
        } 
        
        /** turn the path into a string
        * @param path int array with path indices
        * @return String representing the path
        */
        private String path2String( int[] path ) {
            return path2String( path, path.length );
        }
        
        /** turn the path into a string
        * @param path int array with path indices
        * @param length number of steps in the path array to include
        * @return String representing the path
        */
        private String path2String( int[] path, int length ) {
            if (length > path.length) length = path.length;
            String s = "";
            for ( int i = 0; i < length; i++ )
                s += path[i] + " ";
            return s;
        }
    }
}
