        moduleDescription = "Resample traces based upon correlation with a pattern";
        moduleVersion = "1.2";
        helpFile = "doc/manual/modulesPatternResample.html";
        threshold = 0.0f;
        action = CORRELATE;
        align = LEFT;
        minDistance = 0;
        maxDistance = 0;
        beginCompression = 0;
        endCompression = 0;
        beginIndex = 0;
        endIndex = 0;
        detectionMethod = DETECT_PATH;
        patternFilePath = "";
        set(THRESHOLD, threshold);
        set(ACTION, action);
        set(ALIGN, align);
        set(DISTANCE_MINIMAL, minDistance);
        set(DISTANCE_MAXIMAL, maxDistance);
        set(COMPRESSION_START, beginCompression);
        set(COMPRESSION_END, endCompression);
        set(PATTERN_FILE_PATH, patternFilePath);
        set(BEGIN_INDEX, beginIndex);
        set(END_INDEX, endIndex);
        set(DETECTION_METHOD, detectionMethod);
    }

