    public void actionPerformed(ActionEvent e) {
        if (e != null && e.getSource() == patternSelectButton) {
            try {
                FileDialog fd = new FileDialog(this, "Select pattern trace set", FileDialog.LOAD);
                fd.setFilenameFilter(this);
                fd.setDirectory(traceSetPath);
                fd.setVisible(true);
                String selectedFile = fd.getFile();
                if (selectedFile != null) {
                    set(PATTERN_FILE_PATH, patternFilePath = new File(fd.getDirectory(), selectedFile).getPath());
                    patternTraceTextField.setText(patternFilePath);
                }
            } catch (Exception exc) {
                err("ERROR: could not load pattern trace");
                exc.printStackTrace();
            }
        }
        leftButton.setEnabled(filterButton.isSelected());
        rightButton.setEnabled(filterButton.isSelected());
        beginIndexTextField.setEnabled(filterButton.isSelected());
        endIndexTextField.setEnabled(filterButton.isSelected());
        minDistanceTextField.setEnabled(filterButton.isSelected());
        maxDistanceTextField.setEnabled(filterButton.isSelected());
        startCompressionTextField.setEnabled(filterButton.isSelected());
        endCompressionTextField.setEnabled(filterButton.isSelected());
    }
    
    public boolean accept(File dir, String name) {
        return name.endsWith(".trs");
    }
    
